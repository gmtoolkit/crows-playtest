{{!-- One expertise: name, spendable use pips, and its trained total. --}}
<li class="expertise-row {{#unless row.remaining}}exhausted{{/unless}}" data-expertise="{{row.key}}">
  <span class="exp-name">{{row.label}}</span>

  <span class="exp-pips" data-tooltip="{{row.remaining}} / {{row.uses}}">
    {{#each row.pips}}
      <span class="exp-pip {{#if this.spent}}spent{{/if}}"></span>
    {{/each}}
  </span>

  {{#if editable}}
    <input class="exp-uses" type="number" min="0" name="system.expertises.{{row.key}}.uses" value="{{row.uses}}"
           data-tooltip="{{localize 'CROWS.TrainedUses'}}">
    <input class="exp-spent" type="number" min="0" name="system.expertises.{{row.key}}.spent" value="{{row.spent}}"
           data-tooltip="{{localize 'CROWS.SpentUses'}}">
  {{else}}
    <span class="exp-count">{{row.remaining}}/{{row.uses}}</span>
  {{/if}}
</li>

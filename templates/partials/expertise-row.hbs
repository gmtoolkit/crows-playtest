{{!-- One expertise: name, spendable use pips, and "left / trained".

      WHICH NUMBER IS EDITABLE IS THE POINT.

      The denominator is TRAINED USES: background plus advancement bonuses. It
      is permanent, it is system-owned, and it is not a thing you type. It used
      to be the free-text box on this row purely because backgrounds were not
      modelled and nothing else could enter a crow's starting uses — a data
      entry hole, never a design. Now that backgrounds exist, it is a readout.

      The numerator is USES LEFT, which is transient and resets every rest. If
      anything on this row is hand-adjustable it is this one, so it is: the
      pips spend and restore, and the number itself takes a direct edit for the
      cases pips are clumsy for. --}}
<li class="expertise-row {{#unless row.remaining}}exhausted{{/unless}} {{#if row.uses}}trained{{/if}}"
    data-expertise="{{row.key}}">
  <span class="exp-name">{{row.label}}</span>

  <span class="exp-pips">
    {{#each row.pips}}
      <button type="button" class="exp-pip {{#if this.spent}}spent{{/if}}"
              data-action="toggleExpertiseUse" data-expertise="{{../row.key}}" data-index="{{@index}}"
              data-tooltip="{{#if this.spent}}{{localize 'CROWS.RestoreUse'}}{{else}}{{localize 'CROWS.SpendUse'}}{{/if}}"></button>
    {{/each}}
  </span>

  <span class="exp-count" data-tooltip="{{localize 'CROWS.ExpertiseCountHint'}}">
    {{#if editable}}
      <input class="exp-remaining-input" type="number" min="0" max="{{row.uses}}"
             name="system.expertises.{{row.key}}.remainingInput" value="{{row.remaining}}"
             data-tooltip="{{localize 'CROWS.UsesLeftHint'}}">
    {{else}}
      <span class="exp-remaining">{{row.remaining}}</span>
    {{/if}}
    <span class="exp-sep">/</span>
    <span class="exp-trained" data-tooltip="{{localize 'CROWS.TrainedHint'}}">{{row.uses}}</span>
  </span>
</li>

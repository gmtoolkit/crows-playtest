{{!-- A rollable characteristic chip, shared by the crow and creature sheets. --}}
<button type="button" class="characteristic" data-action="rollCharacteristic" data-characteristic="{{key}}"
        data-tooltip="{{localize 'CROWS.RollHint'}}">
  <span class="abbr">{{abbr}}</span>
  <span class="value">{{crowsSigned value}}</span>
  <span class="label">{{label}}</span>
</button>

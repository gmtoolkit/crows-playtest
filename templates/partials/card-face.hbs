{{!-- One inventory card. Mirrors the printed card layout: name, then the
      stat line that matters for its type, then usage dice as pips. --}}
{{!-- The CLASS `draggable` is what makes this draggable, not the attribute.
      ActorSheetV2 builds one DragDrop with `dragSelector: ".draggable"` and
      ignores DEFAULT_OPTIONS.dragDrop entirely — that option is a v1
      Application thing. So the cards carried draggable="true", the browser let
      you pick them up, and Foundry's handler was never bound to them: nothing
      could be dragged to the hotbar, or anywhere else off the sheet. --}}
<div class="card-face draggable type-{{item.type}} {{#if item.system.magic}}magic{{/if}}"
     data-item-id="{{item.id}}" draggable="true">

  <header class="card-head">
    <img class="card-img" src="{{item.img}}" alt="{{item.name}}">
    <span class="card-name">{{item.name}}</span>
    {{#if (crowsGt item.system.quantity 1)}}<span class="card-qty">&times;{{item.system.quantity}}</span>{{/if}}
  </header>

  <div class="card-body">
    {{#if (crowsEq item.type "weapon")}}
      <div class="card-line">
        {{#if (crowsEq item.system.range.type "ranged")}}
          <i class="fa-solid fa-bullseye"></i> {{item.system.range.value}}
        {{else}}
          <i class="fa-solid fa-hand-fist"></i> {{item.system.range.value}}
        {{/if}}
        <span class="card-group">{{crowsLabel "weaponGroups" item.system.group}}</span>
      </div>
      {{!-- Resolved for whoever carries it, so the slot shows "5 / 8" rather
            than the raw "3 + @mod / 6 + @mod". --}}
      <div class="card-dmg" data-tooltip="{{item.system.notationTier2}} / {{item.system.notationTier3}}">
        <span class="t2">{{item.system.displayTier2}}</span>
        <span class="t3">{{item.system.displayTier3}}</span>
      </div>
    {{/if}}

    {{#if (crowsEq item.type "armor")}}
      <div class="card-line">
        <span class="card-group">{{crowsLabel "armorCategories" item.system.category}}</span>
      </div>
      <div class="card-ad {{#if item.system.depleted}}depleted{{/if}}">
        <i class="fa-solid fa-shield"></i>
        <span>{{item.system.ad.value}}/{{item.system.ad.max}}</span>
        {{#if item.system.worn}}<i class="fa-solid fa-user-shield" title="{{localize 'CROWS.Worn'}}"></i>{{/if}}
      </div>
    {{/if}}

    {{#if (crowsEq item.type "spellbook")}}
      <div class="card-line">
        <span class="card-rank">R{{item.system.rank}}</span>
        <span class="card-group">{{crowsLabel "disciplines" item.system.discipline}}</span>
      </div>
      {{#if item.system.isAttack}}
        <div class="card-dmg" data-tooltip="{{item.system.notationTier2}} / {{item.system.notationTier3}}">
          <span class="t2">{{item.system.displayTier2}}</span>
          <span class="t3">{{item.system.displayTier3}}</span>
        </div>
      {{/if}}
    {{/if}}

    {{#if (crowsEq item.type "gear")}}
      {{#if (crowsGt item.system.light.bright 0)}}
        {{!-- "5/5" alone was read as five fuel of five. It is the light RADII,
              bright over dim, and it sat next to a torch with zero fuel left
              looking like a full one. It says what it is now, and whether the
              thing is actually burning. --}}
        <div class="card-line light {{#if item.system.lit}}lit{{else}}out{{/if}}"
             data-tooltip="{{#if item.system.lit}}{{localize 'CROWS.LitHint'}}{{else}}{{localize 'CROWS.OutHint'}}{{/if}}">
          <i class="fa-solid {{#if item.system.lit}}fa-fire{{else}}fa-fire-flame-simple{{/if}}"></i>
          <span class="light-radii">{{item.system.light.bright}}/{{item.system.light.dim}}</span>
          <span class="light-state">
            {{~#if item.system.lit}}{{localize "CROWS.Lit"}}
            {{~else if item.system.outOfFuel}}{{localize "CROWS.Out"}}
            {{~else if item.system.stowed}}{{localize "CROWS.Stowed"}}
            {{~else}}{{localize "CROWS.Out"}}{{/if~}}
          </span>
        </div>
      {{/if}}
    {{/if}}
  </div>

  {{#if item.system.ud.max}}
    <div class="card-ud" data-action="rollUsageDice" data-tooltip="{{localize 'CROWS.RollUsageDice'}}">
      {{{crowsUsagePips item.system.ud.value item.system.ud.max}}}
    </div>
  {{/if}}

  <div class="card-actions">
    <button type="button" class="icon" data-action="useItem" data-tooltip="{{localize 'CROWS.Use'}}">
      <i class="fa-solid fa-dice-d10"></i>
    </button>
    <button type="button" class="icon" data-action="editItem" data-tooltip="{{localize 'CROWS.Edit'}}">
      <i class="fa-solid fa-pen"></i>
    </button>
    {{#if (crowsEq item.type "armor")}}
      <button type="button" class="icon" data-action="wearArmor" data-tooltip="{{localize 'CROWS.Wear'}}">
        <i class="fa-solid fa-user-shield"></i>
      </button>
    {{/if}}
    {{#if (crowsEq container "backpack")}}
      <button type="button" class="icon" data-action="drawFromPack" data-tooltip="{{localize 'CROWS.DrawFromPack'}}">
        <i class="fa-solid fa-hand"></i>
      </button>
    {{/if}}
    <button type="button" class="icon danger" data-action="deleteItem" data-tooltip="{{localize 'CROWS.Delete'}}">
      <i class="fa-solid fa-trash"></i>
    </button>
  </div>
</div>

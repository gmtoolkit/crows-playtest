{{!-- Traits owned, grouped by tree in purchase order. --}}
<section class="tab crow-traits" data-tab="traits" data-group="sheet">

  <nav class="trait-actions">
    <button type="button" data-action="buyTrait">
      <i class="fa-solid fa-diagram-project"></i> {{localize "CROWS.BrowseTraits"}}
    </button>
    <span class="xp-available">{{localize "CROWS.AvailableXP"}}: <strong>{{system.xp.available}}</strong></span>
  </nav>

  {{#each traitsByTree}}
    <div class="trait-tree">
      <h3>{{this.label}}</h3>
      <ul class="trait-list">
        {{#each this.traits}}
          <li class="trait" data-item-id="{{this.id}}">
            <header>
              <span class="trait-name">{{this.name}}</span>
              <span class="trait-cost">{{this.system.cost}} XP</span>
              <span class="trait-controls">
                <button type="button" class="icon" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
                <button type="button" class="icon danger" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
              </span>
            </header>
            <div class="trait-desc">{{{this.system.description}}}</div>
          </li>
        {{/each}}
      </ul>
    </div>
  {{else}}
    <p class="empty">{{localize "CROWS.NoTraits"}}</p>
  {{/each}}
</section>

{{!-- The stat block the Characters book tells you to scribble on paper.
      Deliberately thin: the slot grid below is the real sheet. --}}
<header class="crow-header">

  <div class="identity">
    {{!-- Decorative only; the class is what resolves the glyph, never a
          hardcoded codepoint. --}}
    <i class="fa-solid fa-crow crow-watermark" aria-hidden="true"></i>
    {{!-- data-action is REQUIRED alongside data-edit: ApplicationV2 routes the
         file picker off the ACTION, so data-edit alone made this look clickable
         and do nothing at all. --}}
    <img class="portrait" src="{{actor.img}}" data-action="editImage" data-edit="img"
         alt="{{actor.name}}" data-tooltip="{{localize 'CROWS.ChangePortraitHint'}}">
    <div class="names">
      <input class="crow-name" type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'CROWS.Name'}}">
      <div class="sub">
        {{!-- Background is STRUCTURED: one of 36 rolled on a 2d6 table, and it
              decides characteristics, Stamina, a starting trait, expertise uses
              and a kit. It gets a lookup, not a text box.

              Feature is NOT. The book says "give your PC a name and a
              distinguishing feature ... a tattoo, distinct body odor, unique
              voice, strong personality trait, or the like" (C p1) — no table,
              nothing derives from it. Free text is the correct shape there, and
              making it a picker would invent a list MCDM did not print. --}}
        {{!-- Both fields carry a VISIBLE label. A placeholder is not a label:
              it disappears the moment the field is filled, which left "Missing
              two fingers" sitting in an unmarked box that nobody could
              identify. --}}
        <div class="field">
          <label>{{localize "CROWS.Background"}}</label>
          <div class="lookup">
            <input type="text" name="system.biography.background" value="{{system.biography.background}}"
                   placeholder="{{localize 'CROWS.BackgroundNone'}}" readonly
                   data-tooltip="{{localize 'CROWS.BackgroundHint'}}">
            <button type="button" class="icon" data-action="pickBackground"
                    data-tooltip="{{localize 'CROWS.PickBackground'}}">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>
        </div>
        <div class="field">
          <label>{{localize "CROWS.Feature"}}</label>
          <input type="text" name="system.biography.feature" value="{{system.biography.feature}}"
                 placeholder="{{localize 'CROWS.FeaturePlaceholder'}}"
                 data-tooltip="{{localize 'CROWS.FeatureHint'}}">
        </div>
      </div>
    </div>
  </div>

  <div class="characteristics">
    {{#each characteristics}}
      <button type="button" class="characteristic" data-action="rollCharacteristic" data-characteristic="{{this.key}}"
              data-tooltip="{{localize 'CROWS.RollHint'}}">
        <span class="abbr">{{this.abbr}}</span>
        <span class="value">{{crowsSigned this.value}}</span>
        <span class="label">{{this.label}}</span>
      </button>
    {{/each}}
  </div>

  <div class="vitals">
    <div class="vital stamina">
      <label>{{localize "CROWS.Stamina"}}</label>
      <div class="pair">
        <input type="number" name="system.stamina.value" value="{{system.stamina.value}}">
        <span class="sep">/</span>
        <input type="number" name="system.stamina.max" value="{{system.stamina.max}}">
      </div>
    </div>

    <div class="vital armor" data-tooltip="{{localize 'CROWS.ADHint'}}">
      <label>{{localize "CROWS.ArmorDefense"}}</label>
      <span class="derived">{{system.armor.value}}<span class="sep">/</span>{{system.armor.max}}</span>
    </div>

    <div class="vital speed" data-tooltip="{{localize 'CROWS.SpeedHint'}}">
      <label>{{localize "CROWS.Speed"}}</label>
      <span class="derived {{#if system.speedPenalty}}penalised{{/if}}">{{system.speed.value}}</span>
      {{#if system.speedPenalty}}<span class="penalty">&minus;{{system.speedPenalty}}</span>{{/if}}
    </div>

    <div class="vital wounds {{#if system.dead}}dead{{/if}}">
      <label>{{localize "CROWS.Wounds"}}</label>
      <span class="derived">{{system.woundCount}}<span class="sep">/</span>{{CROWS.containers.backpack.size}}</span>
    </div>
  </div>

  <div class="ledger">
    <div class="field">
      <label>{{localize "CROWS.TotalXP"}}</label>
      <input type="number" name="system.xp.total" value="{{system.xp.total}}">
    </div>
    <div class="field">
      <label>{{localize "CROWS.SpentXP"}}</label>
      <input type="number" name="system.xp.spent" value="{{system.xp.spent}}">
    </div>
    <div class="field">
      <label>{{localize "CROWS.Coin"}}</label>
      <input type="number" name="system.coin" value="{{system.coin}}">
    </div>
    {{#if system.cruelty}}
      <div class="field cruelty" data-tooltip="{{localize 'CROWS.CrueltyHint'}}">
        <label>{{localize "CROWS.Cruelty"}}</label>
        <input type="number" name="system.cruelty" value="{{system.cruelty}}">
      </div>
    {{/if}}
  </div>

  <div class="action-bar">
    <nav class="header-actions">
      <button type="button" data-action="rest"><i class="fa-solid fa-campground"></i> {{localize "CROWS.Rest"}}</button>
      <button type="button" data-action="openBuilder"><i class="fa-solid fa-wand-magic-sparkles"></i> {{localize "CROWS.Builder"}}</button>
      {{!-- No dungeon-turn button here. The clock is the table's, not one
            crow's, and it now lives permanently above the player list where
            everyone can see it without opening a sheet. --}}
    </nav>
    {{> "systems/crows/templates/partials/document-controls.hbs"}}
  </div>

  {{#if system.dead}}
    <div class="dead-banner">{{localize "CROWS.DeadBanner"}}</div>
  {{/if}}
  {{#if system.magicSlotOverload.length}}
    <div class="warning-banner">{{localize "CROWS.MagicOverloadWarning"}}</div>
  {{/if}}
</header>

{{!-- The clock the whole table watches. A dungeon turn is thirty minutes of
      REAL time; the pressure is the mechanic, so this is permanent furniture
      docked above the player list rather than a window you open.

      It collapses to a single bar but never closes — the toggle is the only
      control that is always rendered, in both states. --}}
<div class="turn-hud {{#if collapsed}}collapsed{{/if}} {{#if urgent}}urgent{{/if}} {{#if state.paused}}paused{{/if}} {{#unless state.active}}idle{{/unless}}">

  <button type="button" class="hud-toggle" data-action="toggleHud"
          data-tooltip="{{#if collapsed}}{{localize 'CROWS.ExpandClock'}}{{else}}{{localize 'CROWS.CollapseClock'}}{{/if}}"
          aria-expanded="{{#if collapsed}}false{{else}}true{{/if}}">
    <i class="fa-solid fa-hourglass-half hud-icon"></i>
    <span class="hud-summary">
      {{#if state.active}}
        <span class="hud-clock">{{remainingText}}</span>
        <span class="hud-turn">{{localize "CROWS.Turn"}} {{state.turn}}</span>
      {{else}}
        <span class="hud-clock idle">{{localize "CROWS.NoTurn"}}</span>
      {{/if}}
    </span>
    <i class="fa-solid {{#if collapsed}}fa-chevron-up{{else}}fa-chevron-down{{/if}} hud-chevron"></i>
  </button>

  {{#unless collapsed}}
    <div class="hud-body">
      {{#if state.active}}
        {{#if state.label}}<div class="dt-place">{{state.label}}</div>{{/if}}

        <div class="dt-clock">{{remainingText}}</div>
        <div class="dt-bar"><div class="dt-fill" style="width: {{progress}}%;"></div></div>

        {{#if greed}}
          <div class="dt-greed" data-tooltip="{{localize 'CROWS.GreedHint'}}">
            <i class="fa-solid fa-coins"></i> {{localize "CROWS.GreedBonus"}} +{{greed}}%
          </div>
        {{/if}}

        <div class="dt-en" data-tooltip="{{localize 'CROWS.ENHint'}}">
          <span>{{localize "CROWS.EncounterNumber"}}</span>
          {{#if isGM}}<button type="button" class="icon" data-action="enDown"><i class="fa-solid fa-minus"></i></button>{{/if}}
          <strong>{{state.en}}+</strong>
          {{#if isGM}}<button type="button" class="icon" data-action="enUp"><i class="fa-solid fa-plus"></i></button>{{/if}}
        </div>

        {{#if isGM}}
          <div class="dt-controls">
            <button type="button" data-action="pause">
              <i class="fa-solid {{#if state.paused}}fa-play{{else}}fa-pause{{/if}}"></i>
              {{#if state.paused}}{{localize "CROWS.Resume"}}{{else}}{{localize "CROWS.Pause"}}{{/if}}
            </button>
            <button type="button" data-action="endTurn"><i class="fa-solid fa-forward"></i> {{localize "CROWS.EndTurn"}}</button>
            <button type="button" data-action="encounter"><i class="fa-solid fa-dice-d10"></i> {{localize "CROWS.Check"}}</button>
            <button type="button" class="danger" data-action="stop"><i class="fa-solid fa-stop"></i> {{localize "CROWS.Stop"}}</button>
          </div>
        {{/if}}

      {{else}}
        <p class="dt-idle">{{localize "CROWS.NoDungeonTurn"}}</p>
        {{#if isGM}}
          <button type="button" class="dt-start" data-action="start">
            <i class="fa-solid fa-play"></i> {{localize "CROWS.StartDungeonTurn"}}
          </button>
        {{/if}}
      {{/if}}
    </div>
  {{/unless}}
</div>
